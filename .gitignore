# ── macOS ────────────────────────────────────────────────────────────────────
.DS_Store

# ── Xcode: per-user state ────────────────────────────────────────────────────
# Window positions, breakpoints, scheme ordering. Changes on every launch and
# means nothing to anyone else.
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# ── Build output ─────────────────────────────────────────────────────────────
# Everything under Builds/<exporter>/build/ is generated by Xcode. The .jucer
# and the generated .xcodeproj stay tracked, so a clone still builds.
**/Builds/*/build/
MidiMorfApp/Builds/Android/
# Signing keys live in ~/.midimorf, never in the repo.
*.jks
*.keystore
*.p12
DerivedData/
*.o
*.d

# ── Spikes ───────────────────────────────────────────────────────────────────
# Compiled throwaway binaries; the sources and notes are tracked.
spikes/*
!spikes/*.cpp
!spikes/*.md

# ── Test-only breaks ──────────────────────────────────────────────────────────
# Uncleared samples embedded into Debug builds by Tools/make_dev_breaks.py.
# Never commit them.
MidiMorfApp/Source/DevBreaks.h

# ── Ableton LinkKit ──────────────────────────────────────────────────────────
# Its license forbids passing the SDK on, so it never goes in the repo. Unzip a
# LinkKit release into MidiMorfApp/ThirdParty/LinkKit (see LINK.md).
MidiMorfApp/ThirdParty/LinkKit/

# ── Ableton Link (Android) ───────────────────────────────────────────────────
# GPLv2+ (or Ableton's proprietary license). Kept out until JB settles which;
# clone it into MidiMorfApp/ThirdParty/link (see LINK.md).
MidiMorfApp/ThirdParty/link/
