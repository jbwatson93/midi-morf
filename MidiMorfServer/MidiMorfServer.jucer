<?xml version="1.0" encoding="UTF-8"?>

<JUCERPROJECT id="mMsRv1" name="MidiMorfServer" projectType="guiapp" useAppConfig="0"
              addUsingNamespaceToJuceHeader="0" jucerFormatVersion="1" version="1.0.0"
              bundleIdentifier="com.midimorf.server" companyName="Retro Relic">
  <MAINGROUP id="BQ54sE" name="MidiMorfServer">
    <FILE id="iconFile" name="Icon.png" compile="0" resource="1" file="Icon.png"/>
    <GROUP id="{5C209039-BC4D-7EDE-22FD-4F4C65B25D15}" name="Source">
      <FILE id="a1Main" name="Main.cpp" compile="1" resource="0" file="Source/Main.cpp"/>
      <FILE id="a2EngH" name="MidiMorfEngine.h" compile="0" resource="0"
            file="Source/MidiMorfEngine.h"/>
      <FILE id="a3EngC" name="MidiMorfEngine.cpp" compile="1" resource="0"
            file="Source/MidiMorfEngine.cpp"/>
      <FILE id="a4McH" name="MainComponent.h" compile="0" resource="0" file="Source/MainComponent.h"/>
      <FILE id="a5McC" name="MainComponent.cpp" compile="1" resource="0"
            file="Source/MainComponent.cpp"/>
      <FILE id="a6SlCf" name="SlotConfig.h" compile="0" resource="0" file="Source/SlotConfig.h"/>
      <FILE id="a7Prot" name="MidiMorfProtocol.h" compile="0" resource="0"
            file="Source/MidiMorfProtocol.h"/>
      <FILE id="a8Colr" name="MidiMorfColors.h" compile="0" resource="0"
            file="Source/MidiMorfColors.h"/>
      <FILE id="a9VmpH" name="VirtualMidiPort.h" compile="0" resource="0"
            file="Source/VirtualMidiPort.h"/>
      <FILE id="aAVmpC" name="VirtualMidiPort.cpp" compile="1" resource="0"
            file="Source/VirtualMidiPort.cpp"/>
      <FILE id="aBNsH" name="NetworkServer.h" compile="0" resource="0" file="Source/NetworkServer.h"/>
      <FILE id="aCNsC" name="NetworkServer.cpp" compile="1" resource="0"
            file="Source/NetworkServer.cpp"/>
      <FILE id="aDTrH" name="TransportHandler.h" compile="0" resource="0"
            file="Source/TransportHandler.h"/>
      <FILE id="aEKpH" name="MorfPadHandler.h" compile="0" resource="0" file="Source/MorfPadHandler.h"/>
      <FILE id="aFOcH" name="OmnichordHandler.h" compile="0" resource="0"
            file="Source/OmnichordHandler.h"/>
    </GROUP>
    <FILE id="KqHqMo" name="MorfChordHandler.h" compile="0" resource="0"
          file="Source/MorfChordHandler.h"/>
    <FILE id="aRcHdS" name="RoseChordHandler.h" compile="0" resource="0"
          file="Source/RoseChordHandler.h"/>
  </MAINGROUP>
  <MODULES>
    <MODULE id="juce_audio_basics" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_audio_devices" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_core" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_data_structures" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_events" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_graphics" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_gui_basics" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_gui_extra" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
  </MODULES>
  <JUCEOPTIONS JUCE_STRICT_REFCOUNTEDPOINTER="1"/>
  <EXPORTFORMATS>
    <XCODE_MAC targetFolder="Builds/MacOSX" customPList="&lt;key&gt;NSLocalNetworkUsageDescription&lt;/key&gt;&#10;&lt;string&gt;Midi-Morf needs local network access to connect to your phone&lt;/string&gt;&#10;&lt;key&gt;NSBonjourServices&lt;/key&gt;&#10;&lt;array&gt;&#10;    &lt;string&gt;_midimorf._tcp&lt;/string&gt;&#10;&lt;/array&gt;"
               localNetworkPermissionNeeded="1" bigIcon="iconFile" smallIcon="iconFile">
      <CONFIGURATIONS>
        <CONFIGURATION isDebug="1" name="Debug" targetName="MidiMorfServer"/>
        <CONFIGURATION isDebug="0" name="Release" targetName="MidiMorfServer"/>
      </CONFIGURATIONS>
      <MODULEPATHS>
        <MODULEPATH id="juce_audio_basics" path="../../../../../../../Applications/JUCE/modules"/>
        <MODULEPATH id="juce_audio_devices" path="../../../../../../../Applications/JUCE/modules"/>
        <MODULEPATH id="juce_core" path="../../../../../../../Applications/JUCE/modules"/>
        <MODULEPATH id="juce_data_structures" path="../../../../../../../Applications/JUCE/modules"/>
        <MODULEPATH id="juce_events" path="../../../../../../../Applications/JUCE/modules"/>
        <MODULEPATH id="juce_graphics" path="../../../../../../../Applications/JUCE/modules"/>
        <MODULEPATH id="juce_gui_basics" path="../../../../../../../Applications/JUCE/modules"/>
        <MODULEPATH id="juce_gui_extra" path="../../../../../../../Applications/JUCE/modules"/>
      </MODULEPATHS>
    </XCODE_MAC>
  </EXPORTFORMATS>
</JUCERPROJECT>
